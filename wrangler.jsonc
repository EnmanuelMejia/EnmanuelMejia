{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "enmanuel-mejia",
  "compatibility_date": "2026-09-25",
  "assets": {
    "directory": "./public",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "routes": [
    {
      "pattern": "enmanuelmejia.com",
      "custom_domain": true
    },
    {
      "pattern": "www.enmanuelmejia.com",
      "custom_domain": true
    }
  ]
}