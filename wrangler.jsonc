{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "enmanuel-mejia",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-25",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "enmanueldmejia.com",
      "custom_domain": true
    },
    {
      "pattern": "www.enmanueldmejia.com",
      "custom_domain": true
    }
  ]
}
